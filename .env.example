# TrackVid-BE, the same backend the web admin (TrackVid-FE) logs in to.
# Read at BUILD time (electron-vite inlines VITE_* into the app), so a
# production build must be made with the production URL here.
VITE_APP_BASE_URL=http://localhost:8000

# Google Drive (Screenshots upload + File Share). Same OAuth client as
# share-chat — copy GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from its .env.
# The redirect URI must be listed under the client's "Authorized redirect
# URIs"; port 3000 must be free while signing in. Read at BUILD time.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
MAIN_VITE_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
